# macOS 로컬 파일
.DS_Store

# 의존성
node_modules/
target/

# Obsidian 플러그인 빌드/로컬 설정 산출물
main.js
data.json
agent-diagnostics.json*
agent-diagnostics.ndjson*
agent-diagnostics-safe-mode.json
.env.test.local

# 로컬 임베딩 모델 다운로드와 삭제 표식
/embeddinggemma-300m/
/ternlight-base.deleted
/embeddinggemma-300m.deleted

# 개발용 Obsidian 테스트 볼트
.test-vault/

# 시뮬레이션/브라우저 테스트 산출물
sim-*.png
simulations/
.playwright-mcp/

# 임시 백업 파일
*.bak

# Command Code 로컬 상태(권한 승인·taste 학습)
.commandcode/

# 마케팅 자산·코드·도구 산출물은 로컬에 두고 검토한 문서만 공유
/marketing/**
!/marketing/**/
!/marketing/AGENTS.md
!/marketing/SPEC.md
!/marketing/video-plan.md
!/marketing/visual-tone.md
!/marketing/scenario.md
