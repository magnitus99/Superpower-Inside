# live MCP 테스트를 data.json 없이 실행해야 할 때만 복사해서 사용합니다.
# 실제 키는 .env.test.local에만 넣고 커밋하지 않습니다.
RUN_LIVE_MCP_TESTS=1
MCP_TEST_DEFAULT_MODEL=openRouter:openrouter/free
MCP_TEST_MCP_PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
MCP_TEST_SERVERS_JSON=[{"name":"serper","command":"uvx","args":["serper-mcp-server"],"env":{"SERPER_API_KEY":"replace-me"}}]
