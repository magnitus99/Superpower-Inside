    "fake-indexeddb": "^6.2.5",
    "obsidian": "latest",
    "prettier": "^3.5.3",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^4.1.6"
  }
