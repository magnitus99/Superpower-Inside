{
  "name": "superpower-inside",
  "version": "2026.10.14",
  "description": "Find answers in your notes, compare sources, and draft with AI.",
  "main": "main.js",
  "scripts": {
    "prepare": "node scripts/install-copy-hooks.mjs",
    "hooks:install": "node scripts/install-copy-hooks.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "copy:check:online": "node scripts/check-copy.mjs --online",
    "copy:fix": "node scripts/check-copy.mjs --fix",
    "dev": "npm run wasm:build && npm run ternlight:assets && node esbuild.config.mjs",
    "build": "npm run wasm:build && npm run ternlight:assets && node esbuild.config.mjs production",
    "lint": "eslint src/ main.ts",
    "review": "node scripts/validate-obsidian-review.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run check:i18n && npm run chat:ux-gate && npm run chat:quality-eval",
    "chat:quality-eval": "node scripts/evaluate-chat-quality.mjs",
    "chat:tool-eval": "node scripts/evaluate-chat-quality.mjs --obsidian-vault .test-vault",
    "test:e2e": "vitest run src/e2e/product-journeys.test.ts",
    "chat:ux-gate": "node scripts/check-chat-ux-fixtures.mjs",
    "rag:perf-gate": "node scripts/bench-rag-wrapper.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "wasm:build": "node scripts/run-fish.mjs scripts/build-rag-wasm.fish && node scripts/build-workers.mjs",
    "ternlight:assets": "node scripts/run-fish.mjs scripts/copy-ternlight-assets.fish",
    "rust:security": "node scripts/run-fish.mjs scripts/check-rust-security.fish",
    "security:full": "npm run lint && npm run typecheck && npm run test && npm run rag:perf-gate && npm run rust:security",
    "format": "prettier --write src/ main.ts",
    "rust:check": "node scripts/run-fish.mjs scripts/check-rust-local.fish",
    "quality:local": "node scripts/check-quality.mjs",
    "release:check": "node scripts/run-fish.mjs scripts/check-release.fish",
    "philosophy:check": "node scripts/check-philosophy.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ternlight/base": "0.1.0",
    "dexie": "^4.0.11",
    "eventsource-parser": "3.0.8",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pdfjs-dist": "5.4.54",
    "tesseract.js": "7.0.0"
  },
  "overrides": {
    "obsidian": {
      "moment": "2.31.0"
    },
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.11"
    }
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "@types/node": "^22.15.14",
    "binaryen": "^131.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.26.0",
    "fake-indexeddb": "^6.2.5",
    "obsidian": "latest",
    "prettier": "^3.5.3",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^4.1.6"
  }
}
