{
  "name": "superpower-inside",
  "version": "3.4.0",
  "description": "Find answers in your notes, compare sources, and draft with AI.",
  "packageManager": "npm@12.2.3",
  "main": ".local/plugin/main.js",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "copy:check": "node scripts/check-copy.mjs --offline",
    "copy:check:online": "node scripts/check-copy.mjs --online",
    "copy:fix": "node scripts/check-copy.mjs --fix",
    "dev": "npm run wasm:build && npm run ternlight:assets && node esbuild.config.mjs",
    "build": "npm run wasm:build && npm run search:quality-gate && npm run ternlight:assets && node esbuild.config.mjs production",
    "build:dev": "npm run wasm:build && npm run ternlight:assets && node esbuild.config.mjs dev",
    "lint": "eslint src/ main.ts",
    "review": "node scripts/validate-obsidian-review.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:contracts && npm run vault:leak-check",
    "chat:quality-eval": "node scripts/evaluate-chat-quality.mjs",
    "test:e2e": "vitest run src/e2e/product-journeys.test.ts",
    "chat:ux-gate": "node scripts/check-chat-ux-fixtures.mjs",
    "rag:perf-gate": "node scripts/bench-rag-wrapper.mjs",
    "search:eval": "node scripts/search-eval/run.mjs",
    "search:bench": "node scripts/search-eval/run.mjs --scale 10k --split heldout --repeat 3",
    "check:i18n": "node scripts/check-i18n.mjs",
    "wasm:build": "node scripts/build-rag-wasm.mjs && node scripts/build-workers.mjs",
    "ternlight:assets": "node scripts/copy-ternlight-assets.mjs",
    "rust:security": "node scripts/check-rust-security.mjs",
    "security:full": "npm run lint && npm run typecheck && npm run test && npm run rag:perf-gate && npm run rust:security",
    "format": "prettier --write src/ main.ts",
    "rust:check": "node scripts/check-rust-local.mjs",
    "quality:local": "node scripts/check-quality.mjs",
    "quality:loop": "node scripts/search-eval/quality-loop.mjs",
    "quality:loop:vault": "node scripts/search-eval/quality-loop.mjs --mode=vault",
    "preview:prepare": "node scripts/obsidian-preview.mjs prepare",
    "preview:build": "node scripts/obsidian-preview.mjs build",
    "preview": "node scripts/obsidian-preview.mjs serve",
    "release:check": "node scripts/check-release.mjs",
    "test:e2e:vault": "node scripts/search-eval/run-vault.mjs --queries 24 --timeout-min 180",
    "vault:leak-check": "node scripts/check-vault-leakage.mjs",
    "search:quality-gate": "vitest run src/rag/search-quality-gate.test.ts",
    "test:unit": "vitest run",
    "test:contracts": "npm run check:i18n && npm run chat:ux-gate && npm run chat:quality-eval",
    "policy:branch": "node scripts/check-branch-policy.mjs",
    "release:bump": "node scripts/bump-version.mjs",
    "release:tag": "node scripts/tag-release.mjs",
    "preview:verify": "node scripts/preview-verify.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ternlight/base": "0.1.1",
    "dexie": "^4.4.7",
    "eventsource-parser": "4.1.3",
    "fflate": "0.8.3",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "@types/node": "^26.6.11",
    "binaryen": "^132.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "js-yaml": "^5.5.0",
    "obsidian": "1.14.4",
    "prettier": "^3.10.1",
    "tslib": "^2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
