#!/usr/bin/env node
const { spawnSync } = require('node:child_process');
const args = process.argv.slice(2);
if (args[0] === 'exec') args.splice(1, 0, '-c', 'model_reasoning_effort="high"');
const executable = process.env.PATINA_CODEX_EXECUTABLE;
if (!executable) { console.error('실제 Codex CLI 경로가 없습니다.'); process.exit(1); }
const result = spawnSync(executable, args, { stdio: 'inherit' });
process.exit(result.status ?? 1);
